# ============================================
# Dockerfile.poc  (poc/asset-risk-tier 브랜치 전용 — main 반영 X)
#
# 원본 app/Dockerfile과 동일하고, 딱 한 줄만 다름:
#   빌드 스테이지에서 semver@5.7.1 을 추가 설치함
#
# 이유:
#   원본 데모 앱은 HIGH/CRITICAL 취약점이 0건이라
#   등급별 차단 결과 차이를 보여줄 수 없음.
#   semver@5.7.1 = HIGH 1건(CVE-2022-25883, ReDoS, 5.7.2에서 수정), CRITICAL 0건
#   → 외부 노출 등급(HIGH 이상 차단)에서는 차단, 내부 전용 등급(CRITICAL만 차단)에서는 통과
#   (A-1에서 Log4j를 의도적으로 넣은 것과 같은 방식)
# ============================================

# ---- 빌드 스테이지 ----
FROM node:20-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev \
 && npm install --no-save --omit=dev semver@5.7.1   # [PoC] 의도적 HIGH 취약점 주입

# ---- 최종 스테이지 (원본과 동일) ----
FROM node:20-alpine

RUN apk upgrade --no-cache

RUN rm -rf /usr/local/lib/node_modules/npm \
    /usr/local/lib/node_modules/corepack \
    /opt/yarn-v* \
    /usr/local/bin/npm \
    /usr/local/bin/npx \
    /usr/local/bin/corepack

WORKDIR /app
COPY --from=builder /app/node_modules ./node_modules
COPY package.json .
COPY app.js .

USER node

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:3000/health || exit 1

CMD ["node", "app.js"]
